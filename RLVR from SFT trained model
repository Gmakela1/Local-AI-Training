# Apply chat template to add system prompt
def apply_chat_template(prompt_text):
    messages = [SYSTEM_PROMPT, {"role": "user", "content": prompt_text}]
    return policy_tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True  # adds <assistant> start
